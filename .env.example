# ============================================================
# SHAZAR — environment
#
# Copy to .env.local and fill in from your Supabase project:
#   Supabase dashboard -> Project Settings -> API
#
# .env.local is gitignored. Never commit real values, and never put a
# secret behind a NEXT_PUBLIC_ prefix — anything with that prefix is
# compiled into the JavaScript the browser downloads.
# ============================================================

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The browser key. New projects call this the "publishable" key; older
# ones call it "anon". Set whichever your project shows — the app reads
# both names. It is safe in the browser: Row Level Security decides what
# it can actually see.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Order notifications (optional) ------------------------------
# Server-side only. Leave them empty and the shop works exactly as
# before: each order is logged as "skipped, not configured" and nothing
# is sent. Switch providers on and off in /admin/settings/notifications.

# Telegram: talk to @BotFather to create a bot and get the token, then
# send your bot a message and read the chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# WhatsApp Cloud API (Meta Business). The admin number is the one that
# receives the alert, in full international digits, e.g. 9647501234567.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ADMIN_NUMBER=
# Optional: an approved template, used instead of a plain text message.
# Meta only delivers free-form text within 24 hours of the admin number
# writing to the business number; a template always delivers. Body:
# {{1}} order number, {{2}} total, {{3}} city.
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_TEMPLATE_LANG=en

# ---- Rate limiting (optional but recommended in production) -------
# Client IPs are never stored; they are hashed with this secret before
# being counted. Any long random string. Without it a default is used,
# which still limits requests but is predictable.
# RATE_LIMIT_SECRET=

# ---- Online payments (optional) ----------------------------------
# Server-side only. With none of this set, checkout offers cash on
# delivery alone — exactly as before phase 6.
#
# Online payment needs THREE things before it is offered to customers:
# the provider's credentials, a public URL for its callbacks, and the
# Supabase service-role key (below). Anything missing and the method
# simply does not appear at checkout.

# Where FastPay and FIB send their callbacks and the customer's browser.
# Must be your site's public https origin — not localhost.
# PAYMENT_CALLBACK_BASE_URL=https://shazar.example

# FastPay — credentials from the merchant panel at merchant.fast-pay.iq
# (Store Configuration). Set the IPN URL there to
#   {PAYMENT_CALLBACK_BASE_URL}/api/payments/fastpay/ipn
# FASTPAY_STORE_ID=
# FASTPAY_STORE_PASSWORD=
# staging (default) or production
# FASTPAY_ENVIRONMENT=staging
# Only if your merchant documents give a different host:
# FASTPAY_API_URL=https://staging-apigw-merchant.fast-pay.iq

# FIB — credentials from First Iraqi Bank. Sandbox first; production
# credentials are issued after FIB's integration request form.
# FIB_CLIENT_ID=
# FIB_CLIENT_SECRET=
# sandbox: https://fib.stage.fib.iq   production: https://fib.iq
# FIB_API_URL=https://fib.stage.fib.iq

# Optional: protects the expiry sweep endpoint
# /api/payments/sweep, which releases orders whose payment ran out.
# PAYMENT_SWEEP_SECRET=

# ---- Supabase service role (required for online payments) ---------
# Bypasses RLS, so it is server-only and must NEVER carry a
# NEXT_PUBLIC_ prefix. It is used for exactly one thing: recording what
# FastPay or FIB has just told this server about a payment. Cash on
# delivery does not need it.
# SUPABASE_SERVICE_ROLE_KEY=
